{
  "name": "jt-cloud",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first project vault and file metadata workspace",
  "author": "J Tech Digital World",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "serve": "npx --yes http-server . -p 4173 -c-1",
